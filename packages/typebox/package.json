{
  "name": "@mqttkit/typebox",
  "version": "0.1.0",
  "type": "module",
  "description": "TypeBox adapter for @mqttkit/core — register typebox schemas without manual Standard Schema wrapping.",
  "license": "MIT",
  "homepage": "https://github.com/keyp-dev/mqttkit#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/keyp-dev/mqttkit.git",
    "directory": "packages/typebox"
  },
  "bugs": {
    "url": "https://github.com/keyp-dev/mqttkit/issues"
  },
  "keywords": [
    "mqtt",
    "mqttkit",
    "typebox",
    "standard-schema",
    "schema-validation"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "peerDependencies": {
    "@mqttkit/core": "^0.2.0",
    "@sinclair/typebox": ">=0.34.0 <1"
  },
  "devDependencies": {
    "@mqttkit/core": "workspace:*",
    "@sinclair/typebox": "^0.34.49",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
