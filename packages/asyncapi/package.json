{
  "name": "@mqttkit/asyncapi",
  "version": "0.2.1",
  "type": "module",
  "description": "AsyncAPI 3.0 documentation generator and HTTP plugin for mqttkit.",
  "license": "MIT",
  "homepage": "https://github.com/keyp-dev/mqttkit#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/keyp-dev/mqttkit.git",
    "directory": "packages/asyncapi"
  },
  "bugs": {
    "url": "https://github.com/keyp-dev/mqttkit/issues"
  },
  "keywords": [
    "mqtt",
    "asyncapi",
    "swagger",
    "openapi",
    "documentation",
    "mqttkit",
    "typescript",
    "bun"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@mqttkit/core": "^0.2.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
