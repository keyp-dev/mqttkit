{
  "name": "@mqttkit/zod",
  "version": "0.1.1",
  "type": "module",
  "description": "Zod helpers for @mqttkit/core — attach JSON Schema for AsyncAPI documentation.",
  "license": "MIT",
  "homepage": "https://github.com/keyp-dev/mqttkit#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/keyp-dev/mqttkit.git",
    "directory": "packages/zod"
  },
  "bugs": {
    "url": "https://github.com/keyp-dev/mqttkit/issues"
  },
  "keywords": [
    "mqtt",
    "mqttkit",
    "zod",
    "standard-schema",
    "json-schema",
    "asyncapi"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "peerDependencies": {
    "@mqttkit/core": "^0.2.0",
    "zod": "^3.24.0 || ^4",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@mqttkit/core": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.6"
  }
}
