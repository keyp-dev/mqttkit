{
  "name": "mqttkit-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "test": "bun test packages/core/src/matcher.test.ts packages/core/src/app.test.ts packages/aedes/src/aedes-adapter.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublish:check": "bun run test && bun run typecheck && bun run build",
    "publish:dry-run": "node scripts/publish.mjs --dry-run",
    "publish:packages": "node scripts/publish.mjs",
    "publish:asyncapi": "node scripts/publish.mjs asyncapi"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "bun-types": "^1.3.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
